class Solution {
public:
    /**
     * @param costs: n x k cost matrix
     * @return: an integer, the minimum cost to paint all houses
     */
    int minCostII(vector<vector<int>> &costs) {
        int n = costs.size();
        
        
        if (n == 0) return 0;
        
        int k = costs[0].size();
        int c1 = INT_MAX, c2 = INT_MAX, nm1, nm2;
        for (int j=0; j<k; j++) {
            if (costs[0][j] <= c1) {
                c2 = c1;
                c1 = costs[0][j];
            } else {
                if (costs[0][j] <= c2) {
                    c2 = costs[0][j];
                }
            }
        }
        
        for (int i=1; i<n; i++) {
            int nm1 = INT_MAX, nm2 = INT_MAX;
            for (int j=0; j<k; j++) {
                if (costs[i-1][j] == c1) {
                    costs[i][j] += c2;
                } else {
                    costs[i][j] += c1;
                }
                
                if (costs[i][j] <= nm1) {
                    nm2 = nm1;
                    nm1 = costs[i][j];
                } else {
                    if (costs[i][j] < nm2) {
                        nm2 = costs[i][j];
                    }
                }
            }
            c1 = nm1, c2 = nm2;
        }
        return c1;
        return 0;
    }
};
// greedy solution -> v.v.important

int n = nums.size();
        int cmax = 0, nmax = 0, jump = 0;
        for (int i=0; i<(n-1); i++) {
            nmax = max(nmax, i + nums[i]);
            if (cmax == i) {
                jump++;
                cmax = nmax;
            }
        }
        return jump;
class Solution {
public:
    int jump(vector<int>& nums) {
        int n = nums.size();
        vector<int> dp(n, INT_MAX);
        for (int i=(n-1); i>=0; i--) {
            for (int j=1; j<=dp[i]; j++) {
                int k = (i+j > n-1) ? n-1 : i+j;
                dp[i] = min(dp[k]+1, dp[i]);
            }
        }
        return dp[0];
    }
};
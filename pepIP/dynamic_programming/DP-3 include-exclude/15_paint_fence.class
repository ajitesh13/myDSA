class Solution {
public:
    /**
     * @param n: non-negative integer, n posts
     * @param k: non-negative integer, k colors
     * @return: an integer, the total number of ways
     */
    int numWays(int n, int k) {
        if (n == 0) {
            return 0;
        } else if (n == 1) {
            return k;
        } else {
            int same = k;
            int diff = k*(k-1);
            for (int i=3; i<=n; i++) {
                int presame = same;
                same = diff;
                diff = (k-1)*(presame + diff);
            }
            return same+diff;
        }
    }
};